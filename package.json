{
  "name": "mosimi-plus-demo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mosimi/customer",
    "dev:customer": "npm run dev -w @mosimi/customer",
    "dev:manager": "npm run dev -w @mosimi/manager",
    "dev:api": "npm run dev -w @mosimi/api",
    "db:seed": "npm run db:seed -w @mosimi/api",
    "db:reset": "npm run db:reset -w @mosimi/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build": "npm run build -w @mosimi/customer && npm run build -w @mosimi/manager && node scripts/assemble-dist.mjs",
    "build:customer": "npm run build -w @mosimi/customer",
    "build:manager": "npm run build -w @mosimi/manager",
    "preview": "npm run preview -w @mosimi/customer",
    "mobile:customer:sync": "npm run sync -w @mosimi/customer-mobile",
    "mobile:customer:ios": "npm run open:ios -w @mosimi/customer-mobile",
    "mobile:customer:android": "npm run open:android -w @mosimi/customer-mobile",
    "mobile:manager:sync": "npm run sync -w @mosimi/manager-mobile",
    "mobile:manager:ios": "npm run open:ios -w @mosimi/manager-mobile",
    "mobile:manager:android": "npm run open:android -w @mosimi/manager-mobile"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2"
  }
}
